#!/usr/bin/env python3
"""fleet-inv — CLI over fleet_inventory.py (wq#1453). Thin wrapper; all logic in the lib.

  fleet-inv list [--monitored] [--json]
  fleet-inv get <name> [dotted.key]
  fleet-inv ssh-list [--all] [--status a,b] [--maintenance] [--no-crown-jewel] [--exclude-self]
                     [--self TEXT] [--order name|maint] [--fields f,g,...]
  fleet-inv plugs        # plug_id<TAB>name<TAB>power — hardware.power_hw.plug_id per machine
  fleet-inv check
  fleet-inv verify [<node>|--all] [--dry-run]  # confirm hardware identity facts live via lumen-verify (wq#1688)
  fleet-inv drift        # schema check + declared-vs-store lifecycle + identity evidence — REPORT ONLY, never writes state

ssh-list is the roster feed for the ops scripts (wq#1456): fleet-keymesh, fleet-roll-reboot,
rotate-fleet-pw read it instead of carrying a NODES list. Default = MONITORED() machines with a
resolvable user@tailscale_ip; unresolvable ones are reported on stderr, never silently dropped.
Root: $FLEET_INVENTORY_ROOT overrides the machines/ dir (tests); default = this checkout.
$LUMEN_STATE_PY overrides the state-store CLI fleet_inventory.py reads (tests); default = the real one.

Ownership split (wq#1631, MINERVA_PIPELINE_MAP.md §4.2): machines/*.yaml declares governance,
maint_tier, monitoring policy, roles, ops.known_issues. network.tailscale_ip/lan_ip/ssh.user,
identity.tailnet {hostname, tags} (wq#1692) and the power plug binding are OBSERVED — fleet_inventory.py reads them live from state_facts
(fleet_inventory.observed(), the one place this repo talks to lumen_state.py); the YAML value is
a declared fallback for when the store has no fact yet, never the authority. `drift` audits the
declared YAML against the store and flags a stale declared status.status the store contradicts
(e.g. YAML says active, the store carries an OFFLINE/DEAD signal ops.known_issues never mentions).
hardware.ram.size_gb/storage[].serial stay YAML-declared too (render.py reads them for fleet.html),
but `drift` cross-checks them against the store's stated ram/storage text (wq#2758) so the two
copies can't silently disagree.

`drift` also reports coverage (wq#1611): 0 DRIFT over N fields nobody could compare is not
success. NO-FACT is ratcheted against a baseline file — it may fall, never grow silently.

Exit codes: 0 ok · 1 error/invalid · 2 drift found (drift) or name/key missing (get)
            · 3 coverage regressed: NO-FACT grew past the baseline (drift).
"""
import argparse
import json
import subprocess
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import fleet_inventory as inv  # noqa: E402

BASELINE_NAME = ".drift.coverage_baseline.json"


def _roster(args):
    try:
        return inv.load(strict=True, fallback=not args.strict)
    except inv.InventoryError as e:
        print(f"ERROR {e}", file=sys.stderr)
        sys.exit(1)


def cmd_list(args):
    r = _roster(args)
    recs = inv.monitored(r) if args.monitored else inv.all(r)
    if args.json:
        print(json.dumps([_public(x) for x in recs], indent=2, sort_keys=True, default=str))
        return 0
    rows = []
    for rec in recs:
        st, net = rec.get("status") or {}, rec.get("network") or {}
        mon = st.get("monitoring") or {}
        rows.append((rec["identity"]["name"], st.get("status", "?"),
                     "mon" if inv._is_monitored_rec(rec) else "-",
                     f"{mon.get('interval_s')}s" if inv._is_monitored_rec(rec) else "-",
                     "alert" if inv._is_monitored_rec(rec) and mon.get("alert") else "-",
                     str(net.get("tailscale_ip") or "-"), str(net.get("lan_ip") or "-"),
                     ",".join(rec.get("roles") or []) or "-"))
    hdr = ("NAME", "STATUS", "MON", "IVL", "ALERT", "TAILSCALE_IP", "LAN_IP", "ROLES")
    widths = [max(len(str(x[i])) for x in rows + [hdr]) for i in range(len(hdr))]
    for row in [hdr] + rows:
        print("  ".join(str(c).ljust(widths[i]) for i, c in enumerate(row)).rstrip())
    return 0


def _public(rec):
    return {k: v for k, v in rec.items() if not k.startswith("_")}


def cmd_get(args):
    rec = inv.get(args.name, _roster(args))
    if rec is None:
        print(f"{args.name}: not in inventory", file=sys.stderr)
        return 2
    val = _public(rec)
    if args.key:
        for part in args.key.split("."):
            if isinstance(val, dict) and part in val:
                val = val[part]
            elif isinstance(val, list) and part.isdigit() and int(part) < len(val):
                val = val[int(part)]
            else:
                print(f"{args.name}: no key {args.key!r}", file=sys.stderr)
                return 2
    if isinstance(val, (dict, list)):
        print(json.dumps(val, indent=2, sort_keys=True, default=str))
    else:
        print(val)
    return 0


SSH_FIELDS = ("name", "target", "user", "host", "tailscale_ip", "lan_ip", "ssh_key", "status",
              "monitored", "maint_tier")


def _ssh_row(name, target, rec, self_marker):
    net, st = rec.get("network") or {}, rec.get("status") or {}
    live = inv.observed(name)
    user, _, host = target.partition("@") if "@" in target else ("", "", target)
    if target == self_marker:
        user = live.get("ssh_user") or str((net.get("ssh") or {}).get("user") or "-")
    tier = inv.maint_tier(rec)
    return {"name": name, "target": target, "user": user or "-", "host": host or "-",
            "tailscale_ip": live.get("tailscale_ip") or inv._clean(net.get("tailscale_ip")) or "-",
            "lan_ip": live.get("lan_ip") or inv._clean(net.get("lan_ip")) or "-",
            "ssh_key": inv.ssh_key(rec, "-"), "status": st.get("status", "?"),
            "monitored": "yes" if inv._is_monitored_rec(rec) else "no",
            "maint_tier": ("%g" % tier) if tier < 6 else "-"}


def cmd_ssh_list(args):
    r = _roster(args)
    statuses = [s.strip() for s in args.status.split(",") if s.strip()] if args.status else None
    for s in statuses or ():
        if s not in inv.STATUS_ENUM:
            print(f"ERROR --status {s!r} not in {list(inv.STATUS_ENUM)}", file=sys.stderr)
            return 1
    fields = [f.strip() for f in args.fields.split(",")] if args.fields else ["name", "target"]
    for f in fields:
        if f not in SSH_FIELDS:
            print(f"ERROR --fields {f!r} not in {list(SSH_FIELDS)}", file=sys.stderr)
            return 1
    skipped = []
    rows = inv.ssh_targets(r, monitored=not args.all, statuses=statuses, maintenance=args.maintenance,
                           no_crown_jewel=args.no_crown_jewel, exclude_self=args.exclude_self,
                           local=args.self_marker, skipped=skipped, order=args.order)
    for name, reason in skipped:
        print(f"# {reason}", file=sys.stderr)
    for name, target in rows:
        row = _ssh_row(name, target, r[name], args.self_marker)
        print("\t".join(row[f] for f in fields))
    return 0


def cmd_plugs(args):
    r = _roster(args)
    try:
        pm = inv.plug_map(r)
    except inv.InventoryError as e:
        print(f"ERROR {e}", file=sys.stderr)
        return 1

    def _k(pid):  # P3 < P10, E1 after P*
        m = re.match(r"([A-Za-z]+)(\d+)$", pid)
        return (m.group(1) != "P", m.group(1), int(m.group(2))) if m else (True, pid, 0)

    for pid in sorted(pm, key=_k):
        st = r[pm[pid]].get("status") or {}
        print(f"{pid}\t{pm[pid]}\t{st.get('power', '-')}")
    return 0


def cmd_check(args):
    errs = inv.validate()
    if errs:
        for e in errs:
            print(f"ERROR {e}")
        print(f"INVALID: {len(errs)} error(s)")
        return 1
    r = inv.load(strict=True, fallback=False)
    print(f"OK: {len(r)} machines valid, {len(inv.monitored(r))} monitored; "
          f"last-good written to {inv._last_good_path(None)}")
    return 0


LUMEN_VERIFY = os.environ.get("LUMEN_VERIFY", "/home/lumen/bin/lumen-verify")
IDENTITY_PROBES = "node_identity,node_storage,os_kernel"


def cmd_verify(args):
    """wq#1688: confirm hardware identity facts against the box NOW. Delegates to
    `lumen-verify node`, which confirms curated free text by stable tokens (DMI serial,
    MACs, disk serials, DIMM sum) through lumen_state.report_observation and never rewrites
    it. A node that answered nothing is reported OFFLINE with its newest stored fact."""
    r = _roster(args)
    if bool(args.node) == bool(args.all):
        print("ERROR: give exactly one of <node> or --all", file=sys.stderr)
        return 1
    names = sorted(r) if args.all else [args.node]
    unknown = [n for n in names if n not in r]
    if unknown:
        print(f"ERROR: not in inventory: {', '.join(unknown)}", file=sys.stderr)
        return 1
    cmd = [sys.executable, LUMEN_VERIFY, "node", *names, "--probes", IDENTITY_PROBES, "--json"]
    if args.dry_run:
        cmd.append("--dry-run")
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        print(f"ERROR: lumen-verify rc={p.returncode}: {p.stderr.strip()[:300]}", file=sys.stderr)
        return 1
    res = json.loads(p.stdout)
    by_node = {}
    for d in res["detail"]:
        by_node.setdefault(d["subject"], []).append(d)
    rc = 0
    for name in names:
        rows = by_node.get(name, [])
        answered = [d for d in rows if d["outcome"] in ("confirmed", "superseded")
                    or (d.get("error") or "").startswith(("MISMATCH", "sudo -n denied",
                                                          "stored value states", "no DMI"))]
        if not rows:
            print(f"{name}: no identity facts to verify (NO-FACT)")
            continue
        if not answered:
            why = (rows[0].get("error") or "no answer").splitlines()[0][:100]
            fb = next((d for d in rows if d["predicate"] == "hardware"), rows[0])
            print(f"{name}: OFFLINE/unreachable ({why}) — newest stored {fb['predicate']} = "
                  f"{(fb['value'] or '')[:80]}")
            continue
        lv = "" if args.dry_run else f" · last_verified {inv.last_verified(name) or '-'} (store)"
        print(f"{name}:{lv}")
        for d in sorted(rows, key=lambda d: d["predicate"]):
            err = (d.get("error") or "").splitlines()[0][:110] if d.get("error") else ""
            print(f"  {d['predicate']:15} {d['outcome']:10} {err}")
            if err.startswith("MISMATCH"):
                rc = 2
    print(f"verify: {res['counts']}")
    return rc


class Coverage:
    """checked/matched/drifted/unverifiable for one audit run.

    Cross-repo contract with /home/lumen/minerva/lumen_coverage.py (wq#1611):
    the rendered line must stay byte-identical in shape. Change one, change both.
    """

    def __init__(self, scope):
        self.scope, self.checked, self.matched, self.drifted, self.unverifiable = scope, 0, 0, 0, 0
        self.detail = {}

    def count(self, verdict, reason=None):
        self.checked += 1
        setattr(self, verdict, getattr(self, verdict) + 1)
        if reason:
            self.detail[reason] = self.detail.get(reason, 0) + 1

    def line(self):
        s = (f"coverage[{self.scope}]: checked {self.checked} · matched {self.matched}"
             f" · drifted {self.drifted} · unverifiable {self.unverifiable}")
        if self.detail:
            s += " (" + ", ".join(f"{k} {self.detail[k]}" for k in sorted(self.detail)) + ")"
        return s

    def as_dict(self):
        return {"scope": self.scope, "checked": self.checked, "matched": self.matched,
                "drifted": self.drifted, "unverifiable": self.unverifiable,
                "detail": dict(self.detail)}


def _baseline_path(args):
    return args.baseline or os.path.join(inv._root(None), BASELINE_NAME)


def _read_baseline(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def _write_baseline(path, cov):
    try:
        with open(path, "w") as f:
            json.dump(cov.as_dict(), f, indent=2, sort_keys=True)
    except OSError as e:
        print(f"# could not write coverage baseline {path}: {e}", file=sys.stderr)


def _coverage_gate(args, cov):
    """Ratchet NO-FACT against the baseline. Returns True if coverage regressed.

    The baseline falls freely and rises only with --accept-baseline: closing a gap
    locks it in, opening one keeps failing until somebody looks at it.
    """
    if args.no_baseline:
        return False
    path = _baseline_path(args)
    prev = _read_baseline(path)
    now = cov.detail.get("no-fact", 0)
    if prev is None:
        _write_baseline(path, cov)
        print(f"coverage: no baseline yet — recorded no-fact {now} at {path}")
        return False
    was = (prev.get("detail") or {}).get("no-fact", 0)
    if now > was and not args.accept_baseline:
        print(f"coverage: NO-FACT grew {was} -> {now} — {now - was} inventory field(s) newly "
              f"have no counterpart in lumen_state. Ingest them or run with --accept-baseline.")
        return True
    if now != was:
        print(f"coverage: NO-FACT {was} -> {now} — baseline updated at {path}")
    _write_baseline(path, cov)
    return False


# wq#1631: a declared status.status=active the store contradicts with no ops.known_issues
# acknowledgment is the lifecycle drift case (thoth: YAML active, store tailnet-OFFLINE since
# 09-02, known_issues DOES mention it -> MATCH, not DRIFT — the declared record is caught up).
_TROUBLE_WORDS = ("OFFLINE", "DEAD", "DECOMMISSIONED", "UNREACHABLE")
_ACK_WORDS = ("offline", "dead", "decommission", "unreachable")


# MagicDNS lowercases node names; `tailscale status --json` reports the OS hostname as typed.
_CASEFOLD_FIELDS = frozenset({"tailnet.hostname"})

# wq#2758: hardware.ram.size_gb/storage[].serial stay YAML-declared (wq#1631 never moved them to
# state_facts observed()), but the store's ram/storage free text is now box-confirmed by
# lumen-verify (wq#1688, the identity.ram/identity.storage rows above). Cross-checking the
# declared YAML against that stated text catches the two hand-kept copies drifting apart without
# a second probe — YAML-vs-store, like every other field here, not a re-verification of the box.
_RAM_GB_RE = re.compile(r"^\s*(\d+)\s*GB\b", re.I)


def _tags_cell(tags):
    """Canonical tag-set string; 'none' = a user-owned device (a real value), None = not recorded."""
    if tags is None:
        return None
    return ",".join(sorted(tags)) or "none"


def cmd_drift(args):
    r = _roster(args)
    rows, drift = [], 0
    cov = Coverage("fleet-inv:inventory-vs-state")
    for rec in inv.all(r):
        name = rec["identity"]["name"]
        net, st = rec.get("network") or {}, rec.get("status") or {}
        facts = inv._state_facts(name)
        live = inv.observed(name, state_fn=lambda _n, f=facts: f)
        tn = (rec.get("identity") or {}).get("tailnet") or {}
        pairs = (
            ("tailscale_ip", inv._clean(net.get("tailscale_ip")), live.get("tailscale_ip")),
            ("lan_ip", inv._clean(net.get("lan_ip")), live.get("lan_ip")),
            ("ssh.user", inv._clean((net.get("ssh") or {}).get("user")), live.get("ssh_user")),
            ("tailnet.hostname", inv._clean(tn.get("hostname")), live.get("tailnet_hostname")),
            ("tailnet.tags", _tags_cell(tn.get("tags")), _tags_cell(live.get("tailnet_tags"))),
        )
        for field, mine, theirs in pairs:
            if theirs is None:
                verdict = "NO-FACT"
                cov.count("unverifiable", "no-fact")
            elif mine is None:
                verdict = "UNVERIFIED"
                cov.count("unverifiable", "no-inventory")
            elif field in _CASEFOLD_FIELDS and mine.casefold() == theirs.casefold():
                verdict = "MATCH"
                cov.count("matched")
            elif mine == theirs:
                verdict = "MATCH"
                cov.count("matched")
            else:
                verdict, drift = "DRIFT", drift + 1
                cov.count("drifted")
            if verdict != "MATCH" or args.verbose:
                rows.append((name, field, mine or "VERIFY", theirs or "-", verdict))
        # wq#1688: identity evidence (hardware/ram/storage/nic/kernel) from the newest
        # lumen-verify check of each open fact. The 3 network fields used to be the only thing
        # compared (0 drift reported while 28 identity disagreements sat unchecked).
        ev = inv.identity_evidence(name)
        for field, _preds in inv.IDENTITY_FIELDS:
            e = ev.get(field)
            if e is None:
                verdict, shown, pred = "NO-FACT", "-", field
                cov.count("unverifiable", "no-fact")
            else:
                pred, outcome, detail, ts = e
                shown = f"{outcome or 'never checked'} {(ts or '')[:10]}".strip()
                if outcome == "confirmed":
                    verdict = "MATCH"
                    cov.count("matched")
                elif (detail or "").startswith("MISMATCH"):
                    verdict, drift, shown = "DRIFT", drift + 1, detail[:60]
                    cov.count("drifted")
                else:
                    verdict = "UNVERIFIED"
                    cov.count("unverifiable", "unverified")
            if verdict != "MATCH" or args.verbose:
                rows.append((name, f"identity.{pred}", "-", shown, verdict))
        # wq#2758: YAML hardware.ram.size_gb/storage[].serial vs the store's stated ram/storage
        # text (already box-confirmed above) — two hand-kept copies of the same identity.
        hw = rec.get("hardware") or {}
        ram_text = facts.get("ram")
        yaml_ram = inv._clean((hw.get("ram") or {}).get("size_gb"))
        m = _RAM_GB_RE.match(ram_text) if ram_text else None
        store_ram = m.group(1) if m else None
        if store_ram is None:
            verdict = "NO-FACT"
            cov.count("unverifiable", "no-fact")
        elif yaml_ram is None:
            verdict = "UNVERIFIED"
            cov.count("unverifiable", "no-inventory")
        elif yaml_ram == store_ram:
            verdict = "MATCH"
            cov.count("matched")
        else:
            verdict, drift = "DRIFT", drift + 1
            cov.count("drifted")
        if verdict != "MATCH" or args.verbose:
            rows.append((name, "hardware.ram.size_gb", yaml_ram or "VERIFY",
                        f"{store_ram}GB" if store_ram else (ram_text or "-"), verdict))

        storage_text = facts.get("storage") or facts.get("storage_layout")
        yaml_serials = [inv._clean(ent.get("serial")) for ent in (hw.get("storage") or [])
                        if isinstance(ent, dict) and inv._clean(ent.get("serial"))]
        if storage_text is None:
            verdict = "NO-FACT"
            cov.count("unverifiable", "no-fact")
        elif not yaml_serials:
            verdict = "UNVERIFIED"
            cov.count("unverifiable", "no-inventory")
        elif any(s.lower() not in storage_text.lower() for s in yaml_serials):
            verdict, drift = "DRIFT", drift + 1
            cov.count("drifted")
        else:
            verdict = "MATCH"
            cov.count("matched")
        if verdict != "MATCH" or args.verbose:
            rows.append((name, "hardware.storage.serial", ",".join(yaml_serials) or "VERIFY",
                        (storage_text or "-")[:60], verdict))
        # declared-vs-store lifecycle check (schema check itself is `fleet-inv check`, separate).
        live_status = (facts.get("status") or "").strip()
        known = " ".join((rec.get("ops") or {}).get("known_issues") or []).lower()
        if not live_status:
            verdict = "NO-FACT"
            cov.count("unverifiable", "no-fact")
        else:
            trouble = any(w in live_status.upper() for w in _TROUBLE_WORDS)
            acked = any(w in known for w in _ACK_WORDS)
            if trouble and st.get("status") == "active" and not acked:
                verdict, drift = "DRIFT", drift + 1
                cov.count("drifted")
            else:
                verdict = "MATCH"
                cov.count("matched")
        if verdict != "MATCH" or args.verbose:
            shown = live_status[:60] + "…" if len(live_status) > 60 else (live_status or "-")
            rows.append((name, "lifecycle", st.get("status", "?"), shown, verdict))
    hdr = ("NODE", "FIELD", "INVENTORY", "LUMEN_STATE", "VERDICT")
    widths = [max(len(str(x[i])) for x in rows + [hdr]) for i in range(len(hdr))]
    for row in [hdr] + rows:
        print("  ".join(str(c).ljust(widths[i]) for i, c in enumerate(row)).rstrip())
    print(f"drift: {drift} disagreement(s) across {len(r)} machines "
          f"(report only; state_facts is authoritative for network.*/ssh.user/tailnet hostname+tags/power plug and "
          f"declared status.status vs store lifecycle — fix by ingesting a fact or updating "
          f"ops.known_issues, never by hand-editing the observed keys)")
    print(cov.line())
    regressed = _coverage_gate(args, cov)
    if drift:
        return 2
    return 3 if regressed else 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="fleet-inv", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--strict", action="store_true",
                    help="fail instead of serving the last-good roster on a parse error")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("list", help="list machines")
    p.add_argument("--monitored", action="store_true", help="only MONITORED() machines")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_list)
    p = sub.add_parser("get", help="print one machine (or one dotted key)")
    p.add_argument("name")
    p.add_argument("key", nargs="?")
    p.set_defaults(fn=cmd_get)
    p = sub.add_parser("ssh-list", help="name<TAB>user@tailscale_ip for every monitored machine (roster feed)")
    p.add_argument("--all", action="store_true", help="every status, not just MONITORED() (pair with --status)")
    p.add_argument("--status", metavar="A,B", help="keep only these status.status values")
    p.add_argument("--maintenance", action="store_true",
                   help="drop governance.never_restart nodes (Thor) — for tooling that updates/reboots")
    p.add_argument("--no-crown-jewel", action="store_true", help="drop governance.crown_jewel nodes")
    p.add_argument("--exclude-self", action="store_true", help="drop the machine this runs on")
    p.add_argument("--self", dest="self_marker", metavar="TEXT",
                   help="print TEXT as the target of the machine this runs on (e.g. LOCAL)")
    p.add_argument("--order", choices=("name", "maint"), default="name",
                   help="maint = by ops.maint_tier then name (A11 §5 ordering law)")
    p.add_argument("--fields", metavar="F,G", help="tab-separated columns: " + ",".join(SSH_FIELDS))
    p.set_defaults(fn=cmd_ssh_list)
    p = sub.add_parser("plugs", help="plug_id<TAB>name<TAB>power from hardware.power_hw.plug_id")
    p.set_defaults(fn=cmd_plugs)
    p = sub.add_parser("check", help="validate every machines/*.yaml; refresh last-good on success")
    p.set_defaults(fn=cmd_check)
    p = sub.add_parser("verify", help="confirm hardware identity facts live via lumen-verify (wq#1688)")
    p.add_argument("node", nargs="?", help="one node (or --all)")
    p.add_argument("--all", action="store_true", help="every machine in the roster")
    p.add_argument("--dry-run", action="store_true", help="probe + report, write no evidence")
    p.set_defaults(fn=cmd_verify)
    p = sub.add_parser("drift", help="declared YAML vs state_facts: network/ssh/plug fields + lifecycle (report only)")
    p.add_argument("-v", "--verbose", action="store_true", help="also print MATCH rows")
    p.add_argument("--baseline", metavar="PATH", help=f"NO-FACT ratchet file (default {BASELINE_NAME} in the root)")
    p.add_argument("--no-baseline", action="store_true", help="report coverage but do not gate on it")
    p.add_argument("--accept-baseline", action="store_true",
                   help="record today's NO-FACT as the new baseline even if it grew")
    p.set_defaults(fn=cmd_drift)
    args = ap.parse_args(argv)
    return args.fn(args)


