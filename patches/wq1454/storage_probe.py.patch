+# ── inventory roster (wq#1454) ───────────────────────────────────────────
+_ROSTER = {"loaded": False, "records": None}
+
+def _roster():
+    """Inventory records (last-good cache on a YAML typo), or None when the
+    inventory AND its cache are unreadable. Loaded once per process."""
+    if not _ROSTER["loaded"]:
+        _ROSTER["loaded"] = True
+        if _inv is not None:
+            try:
+                _ROSTER["records"] = _inv.load(strict=True, fallback=True)
+            except Exception as e:
+                log(f"DEFECT inventory unreadable and no last-good cache ({e}) — legacy roster fallback")
+    return _ROSTER["records"]
+
+def fleet_map_expects_online(node):
+    """MONITORED(node) per the inventory; FLEET_MAP markers only as fallback."""
+    r = _roster()
+    if r is None:
+        return _fleet_map_expects_online(node)
+    return _inv.is_monitored(node, r)
+
+def ssh_target(node):
+    """user@tailscale_ip from the inventory; legacy map only for a name the
+    inventory lacks/cannot resolve (logged as a DEFECT each run)."""
+    r = _roster()
+    if r is not None:
+        if node in r:
+            try:
+                return _inv.ssh_target(node, r)
+            except _inv.InventoryError as e:
+                log(f"DEFECT inventory: {e} — using legacy SSH map for {node}")
+        else:
+            log(f"DEFECT inventory lacks {node} (manifest has it) — using legacy SSH map")
+    return SSH_FALLBACK.get(node)
+
+def parked_set(man, candidates=None):
+    """Nodes scored as PARKED: manifest `parked: true` UNION manifest nodes the
+    inventory does not monitor (monitor:false / decommissioned / dead / in-storage
+    / absent). One YAML edit parks a node here, in Gatus, and everywhere else.
+    `candidates` limits the inventory half to the nodes actually being polled."""
+    nodes = man.get("nodes", {}) or {}
+    parked = {n for n, e in nodes.items() if e.get("parked")}
+    r = _roster()
+    if r is not None:
+        for n in (candidates if candidates is not None else nodes):
+            if n in nodes and not _inv.is_monitored(n, r):
+                parked.add(n)
+    return parked
+
+def roster_report(man):
+    """--roster: what this probe would poll/park and where each SSH target came from."""
+    nodes = [n for n, e in man["nodes"].items() if not e.get("provision_pending")]
+    parked = parked_set(man, nodes)
+    r = _roster()
+    lines = [f"inventory: {'loaded (%d records)' % len(r) if r is not None else 'UNAVAILABLE (legacy fallback)'}",
+             f"polled: {','.join(sorted(n for n in nodes if n not in parked))}",
+             f"parked: {','.join(sorted(parked))}"]
+    for n in sorted(nodes):
+        if n == "lumen":
+            continue
+        src = "inventory" if (r is not None and n in r and _inventory_resolves(n, r)) else "legacy-fallback"
+        lines.append(f"ssh {n}: {ssh_target(n) or 'NONE'} [{src}]")
+    return lines
+
+def _inventory_resolves(n, r):
+    try:
+        _inv.ssh_target(n, r)
+        return True
+    except _inv.InventoryError:
+        return False
+
