 # Policy: eligible nodes ONLY (stateless inference Macs). Anything else is excluded
 # by default, and this hardcoded denylist is a redundant second check, not the
 # primary gate — the primary gate is ELIGIBLE being a closed allowlist.
+# wq#1454: ELIGIBLE is the POLICY allowlist; the set actually ticked is
+# ELIGIBLE ∩ fleet_inventory.monitored() at runtime (eligible_now()), so a node
+# parked/decommissioned in machines/<name>.yaml stops being remediated without a
+# code edit (aq#608/#1070: nephthys kept alerting here after its decommission).
 ELIGIBLE = {"isis", "hathor", "khepri", "nephthys"}
 NEVER_ELIGIBLE = {"lumen", "maat", "wadjet", "anubis", "thoth"}
 assert ELIGIBLE.isdisjoint(NEVER_ELIGIBLE), "policy allowlist/denylist overlap"
+
+FLEET_INVENTORY_ROOT = os.environ.get("FLEET_INVENTORY_ROOT", "/home/lumen/fleet/inventory")
+sys.path.insert(0, FLEET_INVENTORY_ROOT)
+try:
+    import fleet_inventory as _inv
+except Exception as _e:
+    print(f"WARN fleet_inventory unavailable ({_e}) — nothing is eligible (fail-closed)", file=sys.stderr)
+    _inv = None
+
+
+def inventory_monitored():
+    """Names the inventory monitors (last-good cache on a YAML typo), or None if
+    the inventory and its cache are both unreadable."""
+    if _inv is None:
+        return None
+    try:
+        return {rec["identity"]["name"] for rec in _inv.monitored(_inv.load(strict=True, fallback=True))}
+    except Exception as e:
+        print(f"WARN inventory unreadable, no last-good cache ({e}) — nothing is eligible (fail-closed)",
+              file=sys.stderr)
+        return None
+
+
+def eligible_now():
+    """Policy allowlist intersected with the inventory's monitored set. Fail-closed:
+    an unreadable inventory means an empty set (observe-only is the safe default)."""
+    mon = inventory_monitored()
+    return set() if mon is None else (ELIGIBLE & mon)
 
