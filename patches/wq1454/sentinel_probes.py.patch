+    return _inv.is_monitored(node, r)
+
+def _monitored_by_role(role):
+    """[(name, tailscale_ip)] for monitored inventory nodes carrying `role`."""
+    r = _roster()
+    if r is None:
+        return []
+    out = []
+    for rec in _inv.by_role(role, r):
+        name = rec["identity"]["name"]
+        ip = (rec.get("network") or {}).get("tailscale_ip")
+        if _inv.is_monitored(name, r) and ip and ip not in ("VERIFY", "n/a"):
+            out.append((name, str(ip)))
